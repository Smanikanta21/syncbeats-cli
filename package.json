{
  "name": "syncbeats-terminal",
  "version": "1.0.1",
  "description": "SyncBeats terminal client with synchronized room playback",
  "main": "dist/index.js",
  "bin": {
    "syncbeats": "bin/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --format=esm --outfile=dist/index.js --loader:.js=jsx --packages=external",
    "start": "node bin/index.js",
    "dev": "npm run build && node bin/index.js",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "configstore": "^8.0.0",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "node-fetch": "^3.3.2",
    "open": "^11.0.4",
    "react": "^19.3.0",
    "socket.io-client": "^4.8.3",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "socket.io": "^4.8.3",
    "ink-testing-library": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Smanikanta21/syncbeats-cli.git"
  }
}
